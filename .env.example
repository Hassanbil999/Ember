# Optional LLM rephrasing (the platform works fully without any key)
FA_LLM_PROVIDER=none          # none | anthropic | openai | ollama
FA_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_URL=http://localhost:11434
# Dense embeddings: lsa (default, local, no download) or st (sentence-transformers MiniLM)
FA_EMBEDDER=lsa
