# Copy to .env and fill in. Never commit .env. Everything is optional: the demo runs with no keys.

# AI features (summary, Ask). With no key, the summary falls back to a template and Ask returns 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Admin API and the /admin/verify page. Admin is disabled while this is empty or "change-me".
ADMIN_TOKEN=change-me

# Search embeddings: lsa (default, local, no download) or st (sentence-transformers MiniLM, needs PyTorch)
FA_EMBEDDER=lsa

# Ingestion of the public PSI bucket (M5: python -m backend.ingest psi --discover)
PSI_BUCKET=nasa-psi
PSI_REGION=us-west-2

# Web dev server only: where Vite proxies /api. In production the API serves the web app on one port.
VITE_API_URL=http://localhost:8000

# Port for `python run.py start` and the container (Render/Fly/Railway set PORT themselves)
PORT=8000
