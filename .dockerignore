# keep the build context small and never ship local builds, caches or secrets
.git
.env
**/__pycache__
**/*.pyc
.pytest_cache
frontend/node_modules
frontend/.next
frontend/.next-build
frontend/tsconfig.tsbuildinfo
data/processed
data/artifacts
data/raw/**/*.psi-new
data/raw/**/*.part
docs/audit
tests/screens
